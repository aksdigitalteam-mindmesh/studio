
{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        },
        "medicalConditions": {
          "type": "string",
          "description": "Any medical conditions the user has, e.g., diabetes, high blood pressure."
        },
        "workoutDuration": {
            "type": "number",
            "description": "Preferred workout duration in minutes."
        },
        "workoutDaysPerWeek": {
            "type": "number",
            "description": "How many days per week the user can work out."
        },
        "age": {
            "type": "number",
            "description": "The user's age."
        },
        "height": {
            "type": "number",
            "description": "The user's height in centimeters."
        },
        "weight": {
            "type": "number",
            "description": "The user's weight in kilograms."
        },
        "fitnessGoal": {
            "type": "string",
            "enum": ["weight-loss", "build-muscle", "endurance"],
            "description": "The user's primary fitness goal."
        },
        "goalLastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp of when the fitness goal was last updated."
        },
        "goalUpdateCount": {
            "type": "number",
            "description": "How many times the goal has been updated this month."
        }
      },
      "required": ["uid", "email"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "User profile information."
    }
  }
}
